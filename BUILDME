#!/usr/bin/env bash

set -euo pipefail

if [[ -d src/ ]]; then

  printf "Building src/\n"

  mkdir -p dst/lib/

  src=$(find src/ -type f -name "*.java")

  if [[ "${MODE:-development}" == production ]]; then

    javac -cp "dst/lib/*" $src -d dst/lib/

  else

    javac -cp "dst/lib/*" $src -d dst/lib/ -g
 
  fi

  jar cf dst/lib/mywebappserver.jar -C dst/lib/ com/

  rm -r dst/lib/com/

fi

printf "Done\n"

